{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baton installation manifest",
  "type": "object",
  "required": ["schema", "baton_version", "installed_at", "source", "upstreams", "packs", "files", "marker_sections"],
  "properties": {
    "schema": { "const": 1 },
    "baton_version": { "type": "string", "minLength": 1 },
    "installed_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["template", "init"] },
    "upstreams": {
      "type": "object", "required": ["speckit", "atv"],
      "properties": {
        "speckit": { "type": "string", "minLength": 1 },
        "atv": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-": {} }, "additionalProperties": false
    },
    "packs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "contains": { "const": "core" },
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "sha256", "pack", "owner", "managed"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "pack": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "owner": { "enum": ["baton", "speckit", "atv"] },
          "managed": { "type": "boolean" }
        },
        "patternProperties": { "^x-": {} }, "additionalProperties": false
      }
    },
    "marker_sections": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "marker", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "marker": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "patternProperties": { "^x-": {} }, "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\\\]+$" }
  }
}
