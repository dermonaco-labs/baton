{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baton pack definition",
  "type": "object",
  "required": ["schema", "id", "description", "requires", "conflicts", "files"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "minLength": 1 },
    "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "optional_refs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["ref", "reason", "note"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "pattern": "^(?:upstream-absent|pack-provided:[a-z0-9][a-z0-9-]*|excluded:C[0-9]+)$" },
          "note": { "type": "string", "minLength": 1 }
        },
        "patternProperties": { "^x-": {} }, "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "file": {
      "type": "object", "required": ["from", "path"],
      "properties": {
        "from": { "enum": ["speckit", "atv", "baton"] },
        "upstream_path": { "$ref": "#/$defs/path" },
        "path": { "$ref": "#/$defs/path" },
        "role": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "if": { "properties": { "from": { "const": "atv" } }, "required": ["from"] },
      "then": { "required": ["upstream_path"] }
    },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\\\]+$" }
  }
}
