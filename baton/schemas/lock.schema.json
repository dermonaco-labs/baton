{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baton upstream lock",
  "type": "object",
  "required": ["schema", "generated_by", "upstreams", "files"],
  "properties": {
    "schema": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "upstreams": {
      "type": "object", "required": ["speckit", "atv"],
      "properties": {
        "speckit": {
          "type": "object",
          "required": ["package", "version", "repo", "tag", "commit", "requirements", "requirements_sha256", "license", "init_args"],
          "properties": {
            "package": { "$ref": "#/$defs/text" },
            "version": { "$ref": "#/$defs/text" },
            "repo": { "$ref": "#/$defs/text" },
            "tag": { "$ref": "#/$defs/text" },
            "commit": { "$ref": "#/$defs/git_id" },
            "requirements": { "$ref": "#/$defs/path" },
            "requirements_sha256": { "$ref": "#/$defs/sha256" },
            "license": { "$ref": "#/$defs/text" },
            "init_args": { "type": "array", "items": { "$ref": "#/$defs/text" } }
          },
          "patternProperties": { "^x-": {} }, "additionalProperties": false
        },
        "atv": {
          "type": "object",
          "required": ["package", "version", "repo", "ref", "commit", "tree", "license"],
          "properties": {
            "package": { "$ref": "#/$defs/text" },
            "version": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
            "repo": { "$ref": "#/$defs/text" },
            "ref": { "$ref": "#/$defs/text" },
            "commit": { "$ref": "#/$defs/git_id" },
            "tree": { "$ref": "#/$defs/git_id" },
            "license": { "$ref": "#/$defs/text" },
            "note": { "$ref": "#/$defs/text" }
          },
          "patternProperties": { "^x-": {} }, "additionalProperties": false
        }
      },
      "patternProperties": { "^x-": {} }, "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "upstream", "upstream_path", "stored_at", "sha256_upstream", "sha256", "license", "repair", "packs"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "upstream": { "enum": ["speckit", "atv"] },
          "upstream_path": { "$ref": "#/$defs/path" },
          "stored_at": { "$ref": "#/$defs/path" },
          "sha256_upstream": { "$ref": "#/$defs/sha256" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "license": { "$ref": "#/$defs/text" },
          "repair": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object", "required": ["id", "reason", "upstream_issue"],
                "properties": {
                  "id": { "$ref": "#/$defs/text" },
                  "reason": { "$ref": "#/$defs/text" },
                  "upstream_issue": {
                    "oneOf": [{ "const": "pending" }, { "type": "string", "format": "uri", "pattern": "^https://" }]
                  }
                },
                "patternProperties": { "^x-": {} }, "additionalProperties": false
              }
            ]
          },
          "packs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        },
        "patternProperties": { "^x-": {} }, "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\\\]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "git_id": { "type": "string", "pattern": "^[a-fA-F0-9]{40}(?:[a-fA-F0-9]{24})?$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
